# ==========================================
# SyncSphere — PIM System Integration with WooCommerce
# Environment Configuration Template
# ==========================================

# 1. Database Connection
# Default SQLite (zero-config, instant local execution):
DATABASE_URL="file:./dev.db"

# Or Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/syncsphere?schema=public"

# 2. Server Configuration
PORT=4000
NODE_ENV="production"
JWT_SECRET="your_production_jwt_secret_key_here"

# 3. WooCommerce REST API v3 Integration
# Toggle between Simulated Demo Mode and Live WooCommerce store in the dashboard settings
WOO_STORE_URL="https://your-live-woocommerce-store.com"
WOO_CONSUMER_KEY="ck_your_consumer_key_from_woocommerce"
WOO_CONSUMER_SECRET="cs_your_consumer_secret_from_woocommerce"
WOO_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
